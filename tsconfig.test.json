{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist-test",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/main/path-utils.ts",
    "src/main/context-format.ts",
    "src/main/store.ts",
    "src/renderer/terminal-buffer.ts",
    "src/shared/**/*.ts"
  ]
}
